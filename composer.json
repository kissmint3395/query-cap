{
    "name": "kissmint3395/query-cap",
    "description": "A PHP 8.2+ query budget library to track and enforce SQL query limits per request.",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdo", "query", "budget", "performance", "profiling", "n+1"],
    "authors": [
        {
            "name": "kissmint3395",
            "homepage": "https://github.com/kissmint3395"
        }
    ],
    "support": {
        "issues": "https://github.com/kissmint3395/query-cap/issues",
        "source": "https://github.com/kissmint3395/query-cap"
    },
    "require": {
        "php": "^8.2",
        "psr/log": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-strict-rules": "^1.5",
        "phpstan/extension-installer": "^1.3",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "QueryCap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QueryCap\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
